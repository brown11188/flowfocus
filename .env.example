# ─────────────────────────────────────────────────────────────────────
# FlowFocus — Environment Variable Reference
# Copy this file and fill in your values. Never commit real secrets.
# For production/deployed environments, set variables in your container
# runtime (Docker --env-file, docker-compose environment:, etc.)
# ─────────────────────────────────────────────────────────────────────

# Database URL (SQLite file path)
DATABASE_URL="file:./dev.db"

# NextAuth v5 — canonical public URL of the app (NO trailing slash)
# In production this is set automatically by the deployment script.
# For local dev, use http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# NextAuth v5 — secret used to sign/encrypt JWT tokens
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# DeepInfra API Key (for AI-powered task features)
# Get your key at: https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY="your-deepinfra-api-key"

# (Optional) Override the default model used by DeepInfra
# Default: zai-org/GLM-5
# Other options: meta-llama/Llama-3.3-70B-Instruct, mistralai/Mixtral-8x7B-Instruct-v0.1
DEEPINFRA_MODEL="zai-org/GLM-5"

# Google OAuth (optional — only needed if Google sign-in is used)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft OAuth (for Outlook email & calendar integration)
# Azure App Registration info:
#   Tenant ID:     b16e6c57-2a05-4527-9210-ddb885add7d4
#   App (Client) ID: d39e20a7-907b-4d6c-bcb2-0c9bbeaeec45
#   Supported accounts: Personal Microsoft accounts only (consumers tenant)
# Required scopes: offline_access, User.Read, Mail.Read, Calendars.ReadWrite
# Redirect URI to register in Azure Portal:
#   https://buildwith.agentcrew.dev/apps/xklwb3f46m48u5s4h2h5d4pd/api/auth/callback/microsoft-entra-id
MICROSOFT_CLIENT_ID="d39e20a7-907b-4d6c-bcb2-0c9bbeaeec45"
MICROSOFT_CLIENT_SECRET="your-azure-client-secret-here"

# ClickUp OAuth2 App credentials
# Register at: https://app.clickup.com/settings/apps
CLICKUP_CLIENT_ID=""
CLICKUP_CLIENT_SECRET=""
# ClickUp only accepts a bare domain as Redirect URI (path is stripped by their server).
# Workaround: register  https://buildwith.agentcrew.dev/clickup-relay.html  in ClickUp OAuth app.
# The relay page decodes the real callback path from `state` and forwards the browser there.
# Leave CLICKUP_RELAY_URI blank to use the default: <rootDomain>/clickup-relay.html
CLICKUP_RELAY_URI=""

# Base path (baked into Next.js build; matches basePath in next.config.ts)
# For local dev, leave empty or set to match the project path.
NEXT_PUBLIC_BASE_PATH="/apps/xklwb3f46m48u5s4h2h5d4pd"
