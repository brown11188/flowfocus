# ─────────────────────────────────────────────────────────────────────
# FlowFocus — Environment Variable Reference
# Copy this file and fill in your values. Never commit real secrets.
#
# Local development defaults:
# - NEXT_PUBLIC_BASE_PATH=""      → app runs at /
# - DATABASE_URL="file:./data/app.db"
#
# Vercel production recommendation:
# - Deploy at the ROOT domain (no subpath)
# - Set NEXT_PUBLIC_BASE_PATH=""
# - Use a managed Postgres database (Neon / Supabase / Vercel Postgres)
# - Set NEXTAUTH_URL and AUTH_URL to https://your-app.vercel.app
# ─────────────────────────────────────────────────────────────────────

# Database URL
# Local SQLite example:
DATABASE_URL="file:./data/app.db"
# Production Vercel recommendation:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# NextAuth v5 — canonical public URL of the app (NO trailing slash)
# Local dev:
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
# Vercel production example:
# NEXTAUTH_URL="https://your-app.vercel.app"
# AUTH_URL="https://your-app.vercel.app"

# NextAuth v5 — secret used to sign/encrypt JWT tokens
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# DeepInfra API Key (for AI-powered task features)
# Get your key at: https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY="your-deepinfra-api-key"

# (Optional) Override the default model used by DeepInfra
# Default: zai-org/GLM-5
# Other options: meta-llama/Llama-3.3-70B-Instruct, mistralai/Mixtral-8x7B-Instruct-v0.1
DEEPINFRA_MODEL="zai-org/GLM-5"

# Google OAuth (optional — only needed if Google sign-in is used)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft OAuth (for Outlook email & calendar integration)
# Required scopes: offline_access, User.Read, Mail.Read, Calendars.ReadWrite
# Redirect URI examples to register in Azure Portal:
#   Local:  http://localhost:3000/api/auth/callback/microsoft-entra-id
#   Vercel: https://your-app.vercel.app/api/auth/callback/microsoft-entra-id
#   Subpath deployment: https://your-domain.com<BASE_PATH>/api/auth/callback/microsoft-entra-id
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET="your-azure-client-secret-here"

# ClickUp OAuth2 App credentials
# Register at: https://app.clickup.com/settings/apps
CLICKUP_CLIENT_ID=""
CLICKUP_CLIENT_SECRET=""
# ClickUp relay page examples:
#   Local:  http://localhost:3000/clickup-relay.html
#   Vercel: https://your-app.vercel.app/clickup-relay.html
# Leave CLICKUP_RELAY_URI blank to use the app root automatically.
CLICKUP_RELAY_URI=""

# Base path (baked into Next.js build; matches basePath in next.config.ts)
# For Vercel root deployment keep this EMPTY.
# Example subpath deployment only: /apps/flowfocus
NEXT_PUBLIC_BASE_PATH=""

# ─── SMTP / Email (for Forgot Password OTP) ───────────────────────────────────
# Required for the Forgot Password feature to send OTP emails.
# Supports any SMTP provider (Gmail, SendGrid, AWS SES, Mailgun, etc.)
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-app-password  (use Gmail App Password, not account password)
#
# SendGrid example:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASS=your-sendgrid-api-key
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="FlowFocus"
SMTP_FROM_EMAIL="no-reply@flowfocus.app"
