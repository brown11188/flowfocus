{
  "id": "./",
  "name": "FlowFocus — AI-Powered Todo List",
  "short_name": "FlowFocus",
  "description": "AI-powered task management with smart prioritization, focus timer, calendar intelligence, and workspace reporting.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#0f172a",
  "theme_color": "#7c3aed",
  "categories": ["productivity", "business"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icon-maskable.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Quick Capture",
      "short_name": "Capture",
      "description": "Open FlowFocus and capture a task instantly",
      "url": "./today?quickCapture=1",
      "icons": [
        {
          "src": "./icon.svg",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Today",
      "short_name": "Today",
      "description": "Open today's priority list",
      "url": "./today",
      "icons": [
        {
          "src": "./icon.svg",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "Open your FlowFocus dashboard",
      "url": "./dashboard",
      "icons": [
        {
          "src": "./icon.svg",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Friday AI",
      "short_name": "Friday",
      "description": "Open Friday AI assistant",
      "url": "./dashboard?friday=1",
      "icons": [
        {
          "src": "./icon.svg",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Weekly Review",
      "short_name": "Weekly",
      "description": "Open your weekly review",
      "url": "./weekly",
      "icons": [
        {
          "src": "./icon.svg",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./capture",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
